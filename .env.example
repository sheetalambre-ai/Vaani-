# LLM Providers (Groq is primary; Gemini and OpenRouter are fallbacks)
# Copy this file to .env and add keys locally. Never commit .env or share keys in chat.
GROQ_API_KEY=your_groq_api_key_here
GROQ_LLM_MODEL=openai/gpt-oss-20b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# Tracker: mock | trello | github
TRACKER=mock
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# Production database (Vercel): use a managed PostgreSQL URL in project settings.
# Local development keeps SQLite by default.
DATABASE_URL=sqlite+aiosqlite:///./vaanimanthan.db
CRON_SECRET=

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
